<UserControl
    x:Class="Nagi.WinUI.Controls.LyricsTextPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Nagi.WinUI.Resources">

    <!-- The whole panel is one button: a click opens the full lyrics view. The text inside only
         scrolls. -->
    <Button
        x:Name="OpenButton"
        Padding="10,8,2,8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        AutomationProperties.Name="{x:Bind resources:Strings.Player_LyricsButton_ToolTip, Mode=OneTime}"
        Background="{StaticResource ShellLcdBackgroundBrush}"
        BorderBrush="{StaticResource ShellPaneBorderBrush}"
        BorderThickness="1"
        Click="OpenButton_Click"
        CornerRadius="3">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid
                    x:Name="RootGrid"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.BorderBrush" Value="{StaticResource AppPrimaryColorBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.BorderBrush" Value="{StaticResource AppPrimaryColorBrush}" />
                                    <Setter Target="RootGrid.Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}" />
                </Grid>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <!-- Right padding keeps the text clear of the overlay scrollbar. -->
            <ScrollViewer
                x:Name="Scroller"
                Padding="0,0,12,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="LyricsText"
                    FontSize="12"
                    Foreground="{StaticResource ShellMutedTextBrush}"
                    LineHeight="18"
                    TextWrapping="Wrap" />
            </ScrollViewer>
            <TextBlock
                x:Name="NoLyricsText"
                Margin="0,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource ShellLabelTextBrush}"
                Text="{x:Bind resources:Strings.LyricsPage_NoLyrics_Title, Mode=OneTime}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Button>
</UserControl>
