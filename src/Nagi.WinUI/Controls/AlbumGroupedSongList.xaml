<UserControl
    x:Class="Nagi.WinUI.Controls.AlbumGroupedSongList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:imageEx="using:ImageEx"
    xmlns:models="using:Nagi.WinUI.Models"
    xmlns:resources="using:Nagi.WinUI.Resources"
    xmlns:vm="using:Nagi.WinUI.ViewModels"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <UserControl.Resources>
        <models:BrowseListItemTemplateSelector x:Key="BrowseSelector">
            <models:BrowseListItemTemplateSelector.HeaderTemplate>
                <DataTemplate x:DataType="vm:BrowseAlbumHeader">
                    <Grid Margin="0,8,0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="56"
                            Height="56"
                            Background="#FF102832"
                            CornerRadius="4">
                            <imageEx:ImageEx
                                IsCacheEnabled="True"
                                Source="{x:Bind CoverUri}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AppPrimaryColorBrush}"
                                Text="{x:Bind Title}"
                                ToolTipService.ToolTip="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{StaticResource ShellMutedTextBrush}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource ShellLabelTextBrush}"
                                Text="{x:Bind TrackCountText}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </models:BrowseListItemTemplateSelector.HeaderTemplate>
            <models:BrowseListItemTemplateSelector.SongTemplate>
                <DataTemplate x:DataType="vm:BrowseSongRow">
                    <Grid Padding="4,2">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="FileInfo_Click"
                                    Text="{x:Bind resources:Strings.Shell_FileInfo, Mode=OneTime}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <!-- Full-row highlight for the track that is currently playing. -->
                        <Border
                            Background="#331EB8C8"
                            CornerRadius="3"
                            Visibility="{x:Bind IsNowPlaying, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid ColumnSpacing="8" Padding="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="3"
                                Background="{StaticResource AppPrimaryColorBrush}"
                                CornerRadius="1"
                                Visibility="{x:Bind IsNowPlaying, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{StaticResource ShellMutedTextBrush}"
                                Text="{x:Bind TrackNumberText}" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource ShellMutedTextBrush}"
                                Text="{x:Bind DurationText}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </models:BrowseListItemTemplateSelector.SongTemplate>
        </models:BrowseListItemTemplateSelector>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="4,0,4,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Foreground="{StaticResource ShellLabelTextBrush}"
                Text="{x:Bind resources:Strings.Shell_ColNumber, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                Foreground="{StaticResource ShellLabelTextBrush}"
                Text="{x:Bind resources:Strings.Shell_ColTitle, Mode=OneTime}" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                Foreground="{StaticResource ShellLabelTextBrush}"
                Text="{x:Bind resources:Strings.Shell_ColDuration, Mode=OneTime}" />
        </Grid>
        <ListView
            x:Name="SongListView"
            Grid.Row="1"
            DoubleTapped="Songs_DoubleTapped"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource BrowseSelector}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
