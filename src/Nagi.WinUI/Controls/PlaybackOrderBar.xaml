<UserControl
    x:Class="Nagi.WinUI.Controls.PlaybackOrderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Nagi.WinUI.Resources">

    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button
            x:Name="DefaultButton"
            Click="Default_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Order_Default, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8A5;" />
        </Button>
        <Button
            x:Name="RepeatPlaylistButton"
            Click="RepeatPlaylist_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Order_RepeatPlaylist, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8EE;" />
        </Button>
        <Button
            x:Name="RepeatTrackButton"
            Click="RepeatTrack_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Order_RepeatTrack, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8ED;" />
        </Button>
        <Button
            x:Name="ShuffleTracksButton"
            Click="ShuffleTracks_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Order_ShuffleTracks, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8B1;" />
        </Button>
        <Button
            x:Name="ShuffleAlbumsButton"
            Click="ShuffleAlbums_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Order_ShuffleAlbums, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE93C;" />
        </Button>
        <Button
            x:Name="RandomButton"
            Click="Random_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Order_Random, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE148;" />
        </Button>
        <Button
            Click="Filename_Click"
            Style="{StaticResource ShellOrderButtonStyle}"
            ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_TagFilename, Mode=OneTime}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8A5;" />
        </Button>
    </StackPanel>
</UserControl>
