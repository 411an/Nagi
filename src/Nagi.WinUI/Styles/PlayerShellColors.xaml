<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ShellWindowBackgroundBrush" Color="#FF07141A" />
    <SolidColorBrush x:Key="ShellPaneBackgroundBrush" Color="#FF0B1C24" />
    <SolidColorBrush x:Key="ShellInsetBackgroundBrush" Color="#FF102832" />
    <SolidColorBrush x:Key="ShellPaneBorderBrush" Color="#661EB8C8" />
    <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#FF7AA3B0" />
    <SolidColorBrush x:Key="ShellLabelTextBrush" Color="#FF4E7D88" />

    <!-- Status panel: unlit dots stay visible against the panel, like a hardware display. -->
    <SolidColorBrush x:Key="ShellLcdBackgroundBrush" Color="#FF040E13" />
    <SolidColorBrush x:Key="ShellLcdDotOffBrush" Color="#FF10303A" />

    <!-- Unfilled part of the volume, seek and equalizer tracks. -->
    <SolidColorBrush x:Key="ShellSliderTrackBrush" Color="#FF17343E" />

    <Style x:Key="ShellPaneBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellPaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <Style x:Key="ShellIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF123038" />
        <Setter Property="Foreground" Value="{StaticResource AppPrimaryColorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="ShellTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellIconButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="ShellTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ShellMutedTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="ShellTabButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource ShellTabButtonStyle}">
        <Setter Property="Background" Value="#331EB8C8" />
        <Setter Property="Foreground" Value="{StaticResource AppPrimaryColorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryColorBrush}" />
    </Style>

    <Style x:Key="ShellOrderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF102832" />
        <Setter Property="Foreground" Value="{StaticResource ShellMutedTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style x:Key="ShellOrderButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource ShellOrderButtonStyle}">
        <Setter Property="Background" Value="#331EB8C8" />
        <Setter Property="Foreground" Value="{StaticResource AppPrimaryColorBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppPrimaryColorBrush}" />
    </Style>

    <Style x:Key="ShellMetaLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ShellLabelTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>
</ResourceDictionary>
