<UserControl
    x:Class="Nagi.WinUI.MainPage"
    x:Name="MainPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imageEx="using:ImageEx"
    xmlns:localControls="using:Nagi.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:resources="using:Nagi.WinUI.Resources"
    mc:Ignorable="d">

    <Grid x:Name="ShellRoot" Background="{StaticResource ShellWindowBackgroundBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <!-- Hover, pressed and selected states for the whole shell, overlay pages included. -->
                    <ResourceDictionary Source="ms-appx:///Styles/ShellControlOverrides.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="AppTitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*" MinWidth="360" />
            <ColumnDefinition Width="1.4*" MinWidth="360" />
            <ColumnDefinition Width="0.95*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Title strip in place of the Windows title bar. The window is dragged by it, and Windows
             draws minimize, maximize and close over its right end. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.ColumnSpan="3"
            Padding="12,0,0,0"
            Background="{StaticResource ShellWindowBackgroundBrush}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppLogo.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource ShellMutedTextBrush}"
                Text="Nagi Portable" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource ShellLabelTextBrush}"
                Text="{x:Bind AppVersion}" />
            <TextBlock
                x:Name="NowPlayingTitleText"
                Grid.Column="3"
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind FormatNowPlaying(ViewModel.ArtistName, ViewModel.SongTitle), Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Left: transport, vis, EQ, seek, now playing -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ShellPaneBorderStyle}">
            <!-- Right padding reserves a lane for the overlay scrollbar so it does not cover controls. -->
            <ScrollViewer
                x:Name="LeftPaneScroller"
                Padding="0,0,14,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                SizeChanged="LeftPane_SizeChanged">
                <Grid x:Name="LeftPaneGrid" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="LeftPaneStack" Spacing="8" SizeChanged="LeftPane_SizeChanged">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                Click="SettingsButton_Click"
                                Style="{StaticResource ShellIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.NavItem_Settings, Mode=OneTime}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE713;" />
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.ToggleEqualizerCommand}"
                                Content="{x:Bind resources:Strings.Shell_Eq, Mode=OneTime}"
                                Style="{StaticResource ShellIconButtonStyle}" />
                            <Button
                                Click="LyricsButton_Click"
                                Content="{x:Bind resources:Strings.Player_LyricsButton_ToolTip, Mode=OneTime}"
                                Style="{StaticResource ShellIconButtonStyle}" />
                            <Button
                                AllowDrop="True"
                                Content="{x:Bind resources:Strings.Shell_Queue, Mode=OneTime}"
                                DragEnter="QueueButton_DragEnter"
                                DragOver="QueueFlyout_DragOver"
                                Drop="QueueFlyout_Drop"
                                Style="{StaticResource ShellIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind resources:Strings.Player_QueueButton_ToolTip, Mode=OneTime}">
                                <Button.Flyout>
                                    <Flyout x:Name="QueueFlyout" Placement="Bottom">
                                        <Grid Width="300" Height="400" AllowDrop="True" DragOver="QueueFlyout_DragOver" Drop="QueueFlyout_Drop">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Margin="12,0,12,4"
                                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                                Text="{x:Bind resources:Strings.QueueFlyout_Title, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="12,0,12,8"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind resources:Strings.QueueFlyout_DropHint, Mode=OneTime}"
                                                TextWrapping="Wrap" />
                                            <ListView
                                                Grid.Row="2"
                                                ItemsSource="{x:Bind ViewModel.CurrentQueue, Mode=OneWay}"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Song">
                                                        <StackPanel Margin="0,4">
                                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ArtistName}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.ToggleVisualizerCommand}"
                                Content="{x:Bind resources:Strings.Shell_Vis, Mode=OneTime}"
                                Style="{StaticResource ShellIconButtonStyle}" />
                        </StackPanel>

                        <localControls:SpectrumVisualizer
                            IsPlaying="{x:Bind ViewModel.IsPlaying, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsVisualizerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Command="{x:Bind ViewModel.PreviousCommand}" Style="{StaticResource ShellTransportButtonStyle}" ToolTipService.ToolTip="{x:Bind resources:Strings.Player_PreviousButton_ToolTip, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE892;" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.PlayCommand}" Style="{StaticResource ShellTransportButtonStyle}" ToolTipService.ToolTip="{x:Bind resources:Strings.Tooltip_Play, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE768;" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.PauseCommand}" Style="{StaticResource ShellTransportButtonStyle}" ToolTipService.ToolTip="{x:Bind resources:Strings.Tooltip_Pause, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE769;" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource ShellTransportButtonStyle}" ToolTipService.ToolTip="{x:Bind resources:Strings.Player_NextButton_ToolTip, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE893;" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.StopCommand}" Style="{StaticResource ShellTransportButtonStyle}" ToolTipService.ToolTip="{x:Bind resources:Strings.Shell_Stop, Mode=OneTime}">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE71A;" />
                                </Button>
                            </StackPanel>
                            <Slider
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="{StaticResource ShellSliderTrackBrush}"
                                Maximum="100"
                                MinWidth="80"
                                PointerWheelChanged="VolumeSliderContainer_PointerWheelChanged"
                                Style="{StaticResource VolumeSliderStyle}"
                                Value="{x:Bind ViewModel.CurrentVolume, Mode=TwoWay}" />
                        </Grid>

                        <localControls:EqualizerStrip
                            x:Name="EqStrip"
                            Visibility="{x:Bind ViewModel.IsEqualizerVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider
                                Background="{StaticResource ShellSliderTrackBrush}"
                                Maximum="{x:Bind ViewModel.TotalDuration, Mode=OneWay, Converter={StaticResource SliderMaximumConverter}}"
                                Style="{StaticResource MediaSeekerSliderStyle}"
                                ThumbToolTipValueConverter="{StaticResource TimeSpanToTimeStringConverter}"
                                Value="{x:Bind ViewModel.CurrentPosition, Mode=TwoWay}"
                                PointerPressed="MediaSeekerSlider_PointerPressed"
                                PointerReleased="MediaSeekerSlider_PointerReleased"
                                PointerCaptureLost="MediaSeekerSlider_PointerCaptureLost"
                                KeyDown="MediaSeekerSlider_KeyDown"
                                KeyUp="MediaSeekerSlider_KeyUp" />
                            <Grid Grid.Row="1">
                                <TextBlock HorizontalAlignment="Left" Foreground="{StaticResource ShellMutedTextBrush}" Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource ShellMutedTextBrush}" Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="NowPlayingFileInfo_Click"
                                        Text="{x:Bind resources:Strings.Shell_FileInfo, Mode=OneTime}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="110"
                                Height="110"
                                Background="#FF102832"
                                CornerRadius="4">
                                <imageEx:ImageEx
                                    IsCacheEnabled="True"
                                    Source="{x:Bind ViewModel.AlbumArtUri, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}, FallbackValue=null}"
                                    Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Style="{StaticResource ShellMetaLabelStyle}" Text="{x:Bind resources:Strings.Shell_MetaTitle, Mode=OneTime}" />
                                <TextBlock Style="{StaticResource ShellMetaLabelStyle}" Text="{x:Bind resources:Strings.Shell_MetaArtist, Mode=OneTime}" />
                                <TextBlock Style="{StaticResource ShellMetaLabelStyle}" Text="{x:Bind resources:Strings.Shell_MetaAlbum, Mode=OneTime}" />
                                <TextBlock Style="{StaticResource ShellMetaLabelStyle}" Text="{x:Bind resources:Strings.Shell_MetaGenreYear, Mode=OneTime}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{StaticResource AppPrimaryColorBrush}" Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{StaticResource ShellMutedTextBrush}" Text="{x:Bind ViewModel.AlbumName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{StaticResource ShellMutedTextBrush}" Text="{x:Bind ViewModel.GenreYearText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <localControls:PlayerStatusStrip x:Name="StatusStrip" />
                    </StackPanel>

                    <!-- Lyrics of the playing track as plain text, filling the rest of the column. -->
                    <localControls:LyricsTextPanel
                        x:Name="LyricsPanel"
                        Grid.Row="1"
                        OpenRequested="LyricsPanel_OpenRequested" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Middle: playback order + track list -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ShellPaneBorderStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <localControls:PlaybackOrderBar x:Name="OrderBar" Margin="0,0,0,6" />
                <localControls:AlbumGroupedSongList
                    x:Name="SongList"
                    Grid.Row="1"
                    AllowDrop="True"
                    SongPlayRequested="SongList_SongPlayRequested" />
            </Grid>
        </Border>

        <!-- Right: library search / tabs / tree -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ShellPaneBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox
                    Margin="0,0,0,6"
                    PlaceholderText="{x:Bind resources:Strings.Shell_SearchPlaceholder, Mode=OneTime}"
                    Text="{x:Bind Tree.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="LibraryTab"
                        Click="ModeLibrary_Click"
                        Content="{x:Bind resources:Strings.NavItem_Library, Mode=OneTime}"
                        Style="{StaticResource ShellTabButtonSelectedStyle}" />
                    <Button
                        x:Name="PlaylistTab"
                        Click="ModePlaylist_Click"
                        Content="{x:Bind resources:Strings.Shell_TabPlaylist, Mode=OneTime}"
                        Style="{StaticResource ShellTabButtonStyle}" />
                    <Button
                        x:Name="ArtistTab"
                        Click="ModeArtist_Click"
                        Content="{x:Bind resources:Strings.Shell_TabList, Mode=OneTime}"
                        Style="{StaticResource ShellTabButtonStyle}" />
                    <Button
                        Command="{x:Bind Tree.AddFolderCommand}"
                        Content="+"
                        Style="{StaticResource ShellIconButtonStyle}"
                        Visibility="{x:Bind Tree.IsLibraryMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <localControls:LibraryTreePane
                    x:Name="TreePane"
                    Grid.Row="2"
                    NodePlayRequested="TreePane_NodePlayRequested"
                    NodeSelected="TreePane_NodeSelected" />
            </Grid>
        </Border>

        <!-- Tray icon lives here so hide-to-tray has a notify icon after the window is hidden. -->
        <localControls:TrayIconUserControl
            x:Name="AppTrayIconHost"
            Grid.Row="1"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsTabStop="False"
            Opacity="0" />

        <!-- Overlay for Settings / Lyrics / GoTo -->
        <Grid
            x:Name="OverlayHost"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Visibility="Collapsed"
            Background="{StaticResource ShellWindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                Margin="8"
                Click="OverlayBack_Click"
                Content="{x:Bind resources:Strings.Shell_Back, Mode=OneTime}" />
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </Grid>
</UserControl>
