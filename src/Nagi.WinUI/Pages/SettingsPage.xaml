<Page
    x:Class="Nagi.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreModels="using:Nagi.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localConverters="using:Nagi.WinUI.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nagi.WinUI.Models"
    xmlns:mux="using:Microsoft.UI.Xaml"
    xmlns:navigation="using:Nagi.WinUI.Navigation"
    xmlns:resources="using:Nagi.WinUI.Resources"
    xmlns:viewmodels="using:Nagi.WinUI.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource ShellWindowBackgroundBrush}"
    NavigationCacheMode="Required">


    <Page.Resources>
        <localConverters:FloatToDecimalStringConverter x:Key="FloatToDecimalStringConverter" />
        <localConverters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <localConverters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True" />
        <localConverters:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter" />
        <localConverters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <!-- Shared template for service provider items in Lyrics and Metadata source lists -->
        <DataTemplate x:Key="ServiceProviderItemTemplate" x:DataType="viewmodels:ServiceProviderSettingViewModel">
            <Grid x:Name="ProviderItemRoot" Padding="12,8" VerticalAlignment="Center"
                  ToolTipService.ToolTip="{x:Bind Description}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Drag Handle -->
                <FontIcon
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76F;" />

                <FontIcon
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    Foreground="{ThemeResource AppPrimaryColorBrush}"
                    Glyph="&#xE944;" />

                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind DisplayName}" />

                <ToggleSwitch
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RomanizationPackItemTemplate" x:DataType="viewmodels:RomanizationPackViewModel">
            <Border
                Padding="14,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Description, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind DetailsText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            MinWidth="86"
                            Click="RomanizationPackInstall_Click"
                            Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Install, Mode=OneTime}"
                            IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <Button
                            MinWidth="86"
                            Click="RomanizationPackInstall_Click"
                            Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Update, Mode=OneTime}"
                            IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            MinWidth="86"
                            Click="RomanizationPackRemove_Click"
                            Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Remove, Mode=OneTime}"
                            IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsInstalled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            MaxWidth="1200"
            Margin="36,24,36,0"
            Style="{StaticResource SettingsPageTitleTextStyle}"
            Text="{x:Bind resources:Strings.SettingsPage_Title, Mode=OneTime}" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="36,0,36,24">
                <StackPanel
                    MaxWidth="1200"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SettingsPage_Section_Appearance, Mode=OneTime}" />

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_Language_Header, Mode=OneTime}"
                    controls:SettingsCard.Description="{x:Bind resources:Strings.SettingsPage_Language_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="200"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                        SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:LanguageModel">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_RememberWindowSize_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RememberWindowSize_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE740;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsRememberWindowSizeEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_RememberWindowPosition_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RememberWindowPosition_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE737;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsRememberWindowPositionEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SettingsPage_Section_Player, Mode=OneTime}" />

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_VolumeNormalization_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_VolumeNormalization_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE995;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsVolumeNormalizationEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_WasapiExclusive_Header, Mode=OneTime}"
                    Description="{x:Bind resources:Strings.SettingsPage_WasapiExclusive_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE995;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsWasapiExclusiveModeEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsExpander
                    Header="{x:Bind resources:Strings.SettingsPage_FadeOnPlayPause_Header, Mode=OneTime}"
                    Description="{x:Bind resources:Strings.SettingsPage_FadeOnPlayPause_Description, Mode=OneTime}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsFadeOnPlayPauseEnabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind resources:Strings.SettingsPage_FadeInDuration_Header, Mode=OneTime}"
                            Description="{x:Bind resources:Strings.SettingsPage_FadeInDuration_Description, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Slider
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Maximum="1000"
                                    Minimum="0"
                                    StepFrequency="50"
                                    Style="{StaticResource EqualizerSliderStyle}"
                                    Value="{x:Bind ViewModel.FadeInDurationMs, Mode=TwoWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{x:Bind ViewModel.FadeInDurationMs, Mode=OneWay}" />
                                    <Run Text="{x:Bind resources:Strings.SettingsPage_Unit_Milliseconds, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind resources:Strings.SettingsPage_FadeOutDuration_Header, Mode=OneTime}"
                            Description="{x:Bind resources:Strings.SettingsPage_FadeOutDuration_Description, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Slider
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Maximum="1000"
                                    Minimum="0"
                                    StepFrequency="50"
                                    Style="{StaticResource EqualizerSliderStyle}"
                                    Value="{x:Bind ViewModel.FadeOutDurationMs, Mode=TwoWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{x:Bind ViewModel.FadeOutDurationMs, Mode=OneWay}" />
                                    <Run Text="{x:Bind resources:Strings.SettingsPage_Unit_Milliseconds, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind resources:Strings.SettingsPage_Equalizer, Mode=OneTime}" VerticalAlignment="Center" />
                            <HyperlinkButton
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ResetEqualizerCommand}"
                                Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                Content="{x:Bind resources:Strings.SettingsPage_ResetEqualizer_Content, Mode=OneTime}"
                                FontSize="12"
                                Padding="4,2" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="20" HorizontalAlignment="Center">
                        <!-- Preamp slider -->
                        <StackPanel Spacing="6" Width="320">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind resources:Strings.SettingsPage_Equalizer_Preamp, Mode=OneTime}" HorizontalAlignment="Center" />
                            <Slider
                                Maximum="20"
                                Minimum="-20"
                                StepFrequency="0.1"
                                Style="{StaticResource EqualizerSliderStyle}"
                                Value="{x:Bind ViewModel.EqualizerPreamp, Mode=TwoWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}">
                                <Run Text="{x:Bind ViewModel.EqualizerPreamp, Mode=OneWay, Converter={StaticResource FloatToDecimalStringConverter}}" />
                                <Run Text="{x:Bind resources:Strings.SettingsPage_Unit_Decibels, Mode=OneTime}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- EQ Bands -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.EqualizerBands}" HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:EqualizerBandViewModel">
                                    <StackPanel Width="44" Spacing="6">
                                        <!-- 0 dB indicator and slider container -->
                                        <Grid Height="140">
                                            <!-- 0 dB center line -->
                                            <Border
                                                Height="1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.5" />
                                            <!-- Vertical slider -->
                                            <Slider
                                                HorizontalAlignment="Center"
                                                Maximum="20"
                                                Minimum="-20"
                                                Orientation="Vertical"
                                                StepFrequency="0.1"
                                                Style="{StaticResource EqualizerSliderStyle}"
                                                Value="{x:Bind Gain, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FrequencyLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <ComboBox
                            HorizontalAlignment="Center"
                            MinWidth="160"
                            ItemsSource="{x:Bind ViewModel.AvailableEqualizerPresets}"
                            PlaceholderText="{x:Bind resources:Strings.SettingsPage_Equalizer_Preset_Custom_Placeholder, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedEqualizerPreset, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="coreModels:EqualizerPreset">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_RestorePlayback_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RestorePlayback_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsRestorePlaybackStateEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_AutoLaunch_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsAutoLaunchEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_StartMinimized_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_StartMinimized_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE92C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsStartMinimizedEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_MinimizeToMiniPlayer_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE975;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsMinimizeToMiniPlayerEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_HideToTray_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_HideToTray_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE78B;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsHideToTrayEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_TrayCoverArt_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_TrayCoverArt_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEB9F;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsShowCoverArtInTrayFlyoutEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SettingsPage_Section_Data, Mode=OneTime}" />

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_IgnoreLeadingArticles_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_IgnoreLeadingArticles_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8CB;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsIgnoreLeadingArticlesOnSortEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_ArtistSplitting_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_ArtistSplitting_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            Width="150"
                            PlaceholderText="{x:Bind resources:Strings.SettingsPage_FolderExclusion_Placeholder, Mode=OneTime}"
                            Text="{x:Bind ViewModel.ArtistSplitCharacters, Mode=TwoWay}" />
                        <Button
                            Command="{x:Bind ViewModel.RescanMetadataCommand}"
                            Content="{x:Bind resources:Strings.SettingsPage_RescanLibrary_Content, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind resources:Strings.SettingsPage_RescanLibrary_ToolTip, Mode=OneTime}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_GenreSplitting_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_GenreSplitting_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B0;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            Width="150"
                            PlaceholderText="{x:Bind resources:Strings.SettingsPage_FolderExclusion_Placeholder, Mode=OneTime}"
                            Text="{x:Bind ViewModel.GenreSplitCharacters, Mode=TwoWay}" />
                        <Button
                            Command="{x:Bind ViewModel.RescanMetadataCommand}"
                            Content="{x:Bind resources:Strings.SettingsPage_RescanLibrary_Content, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind resources:Strings.SettingsPage_RescanLibrary_ToolTip, Mode=OneTime}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander
                    x:Name="LyricsSettingsExpander"
                    Header="{x:Bind resources:Strings.SettingsPage_OnlineLyrics_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_OnlineLyrics_Description, Mode=OneTime}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE90A;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsFetchOnlineLyricsEnabled, Mode=TwoWay}" />

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind resources:Strings.SettingsPage_LyricsSources_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_LyricsSources_Description, Mode=OneTime}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE179;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ListView
                                x:Name="LyricsProvidersListView"
                                Width="350"
                                HorizontalAlignment="Right"
                                AllowDrop="True"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CanDragItems="True"
                                CanReorderItems="True"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ItemsSource="{x:Bind ViewModel.LyricsProviders}"
                                DragItemsStarting="ProvidersListView_DragItemsStarting"
                                ItemContainerStyle="{StaticResource NavigationListViewItemStyle}"
                                ItemTemplate="{StaticResource ServiceProviderItemTemplate}"
                                SelectionMode="Single" />
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    x:Name="RomanizedLyricsSettingsExpander"
                    Header="{x:Bind resources:Strings.SettingsPage_RomanizedLyrics_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RomanizedLyrics_Description, Mode=OneTime}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8D4;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.IsLyricsRomanizationEnabled, Mode=TwoWay}" />

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Description, Mode=OneTime}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74C;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel
                                Width="520"
                                HorizontalAlignment="Right"
                                Spacing="10">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ProgressRing
                                        Width="24"
                                        Height="24"
                                        IsActive="{x:Bind ViewModel.IsLoadingRomanizationPacks, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLoadingRomanizationPacks, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        MinWidth="86"
                                        Command="{x:Bind ViewModel.RefreshRomanizationPacksCommand}"
                                        Content="{x:Bind resources:Strings.SettingsPage_RomanizationPacks_Refresh, Mode=OneTime}"
                                        IsEnabled="{x:Bind ViewModel.IsLoadingRomanizationPacks, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}" />
                                </StackPanel>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.RomanizationPacksStatus, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.RomanizationPacksStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                                <ItemsControl
                                    ItemTemplate="{StaticResource RomanizationPackItemTemplate}"
                                    ItemsSource="{x:Bind ViewModel.RomanizationPacks, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_PlaylistsIO_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_PlaylistsIO_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B5;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="{x:Bind resources:Strings.SettingsPage_ExportPlaylists_Content, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind resources:Strings.SettingsPage_ExportPlaylists_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.ExportAllPlaylistsCommand}" />
                        <Button
                            Content="{x:Bind resources:Strings.SettingsPage_ImportPlaylists_Content, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind resources:Strings.SettingsPage_ImportPlaylists_ToolTip, Mode=OneTime}"
                            Command="{x:Bind ViewModel.ImportMultiplePlaylistsCommand}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_BackupRestore_Header, Mode=OneTime}"
                    Description="{x:Bind resources:Strings.SettingsPage_BackupRestore_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="{x:Bind resources:Strings.SettingsPage_CreateBackup_Content, Mode=OneTime}"
                            Command="{x:Bind ViewModel.CreateBackupCommand}" />
                        <Button
                            Content="{x:Bind resources:Strings.SettingsPage_RestoreBackup_Content, Mode=OneTime}"
                            Command="{x:Bind ViewModel.RestoreFromBackupCommand}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind resources:Strings.SettingsPage_ResetApp_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_ResetApp_Description, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74D;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.ResetApplicationDataCommand}"
                        Content="{x:Bind resources:Strings.SettingsPage_ResetButton_Content, Mode=OneTime}"
                        Style="{StaticResource SettingsPageResetButtonStyle}" />
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind resources:Strings.SettingsPage_Section_About, Mode=OneTime}" />

                <controls:SettingsExpander
                    Header="{x:Bind resources:Strings.SettingsPage_AboutExpander_Header, Mode=OneTime}" Description="{x:Bind resources:Strings.SettingsPage_AboutExpander_Description, Mode=OneTime}"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True">
                        <Run Text="Nagi Portable Edition" />
                        <Run Text="·" />
                        <Run Text="{x:Bind resources:Strings.SettingsPage_About_VersionPrefix, Mode=OneTime}" />
                        <Run Text="{x:Bind ViewModel.ApplicationVersion, Mode=OneWay}" />
                    </TextBlock>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton
                                    Content="{x:Bind resources:Strings.SettingsPage_About_Licenses_Content, Mode=OneTime}"
                                    Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                    NavigateUri="https://github.com/Anthonyy232/Nagi/blob/master/LICENSE" />
                                <!-- The portable fork and the original project it comes from. -->
                                <HyperlinkButton
                                    Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                    NavigateUri="https://github.com/411an/Nagi">
                                    <TextBlock>
                                        <Run Text="{x:Bind resources:Strings.SettingsPage_About_SourceCode_Content, Mode=OneTime}" />
                                        <Run Text="— Nagi Portable Edition" />
                                    </TextBlock>
                                </HyperlinkButton>
                                <HyperlinkButton
                                    Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                                    NavigateUri="https://github.com/Anthonyy232/Nagi">
                                    <TextBlock>
                                        <Run Text="{x:Bind resources:Strings.SettingsPage_About_SourceCode_Content, Mode=OneTime}" />
                                        <Run Text="— Nagi" />
                                    </TextBlock>
                                </HyperlinkButton>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <HyperlinkButton
                        Content="{x:Bind resources:Strings.SettingsPage_About_PrivacyPolicy_Content, Mode=OneTime}"
                        Style="{StaticResource AnimatedHyperlinkButtonStyle}"
                        NavigateUri="https://github.com/Anthonyy232/Nagi/blob/master/PRIVACY.md" />
                </StackPanel>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
